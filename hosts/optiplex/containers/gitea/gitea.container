[Unit]
Description=Gitea repository
Requires=postgres.service
After=postgres.service

Requires=devops.network
After=devops.network

[Container]
ContainerName=gitea
Image=docker.gitea.com/gitea:1-rootless
AutoUpdate=registry

HealthCmd=curl -k http://127.0.0.1:3000

Network=devops
HostName=gitea
PublishPort=3000:3000
PublishPort=2222:2222

Volume=gitea-data:/var/lib/gitea:Z
Volume=/etc/localtime:/etc/localtime:ro

# Secrets
Secret=gitea-lfs-jwt-secret
Secret=gitea-oauth2-jwt-secret
Secret=gitea-internal-token
Secret=gitea-db-password,type=env,target=GITEA__database__PASSWD

# Configuration
Environment=GITEA__DEFAULT__APP_NAME=FiveLabs.Tech
Environment=GITEA__server__DOMAIN=fivelabs.tech
Environment=GITEA__server__ROOT_URL=https://gitea.fivelabs.tech/
Environment=GITEA__server__SSH_DOMAIN=optiplex.lab
Environment=GITEA__server__LFS_START_SERVER=true
Environment=GITEA__server__LFS_JWT_SECRET_URI=file:/run/secrets/gitea-lfs-jwt-secret
Environment=GITEA__server__OFFLINE_MODE=true

Environment=GITEA__database__DB_TYPE=postgres
Environment=GITEA__database__HOST=host.containers.internal:5432
Environment=GITEA__database__USER=gitea
Environment=GITEA__database__SSL_MODE=require

Environment=GITEA__security__INSTALL_LOCK=true
Environment=GITEA__security__INTERNAL_TOKEN_URI=file:/run/secrets/gitea-internal-token
Environment=GITEA__security__REVERSE_PROXY_TRUSTED_PROXIES=*

Environment=GITEA__service__DISABLE_REGISTRATION=true
Environment=GITEA__service__NO_REPLY_ADDRESS=noreply.localhost

Environment=GITEA__repository_0X2E_signing__DEFAULT_TRUST_MODEL=committer

Environment=GITEA__cron_0X2E_update_checker__ENABLED=false

Environment=GITEA__oauth2__JWT_SECRET_URI=file:/run/secrets/gitea-oauth2-jwt-secret

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
