[Unit]
Description=Nextcloud
After=network-online.target postgres.service valkey.service
Wants=network-online.target
Requires=postgres.service valkey.service

[Container]
ContainerName=nextcloud
Image=docker.io/library/nextcloud:apache
AutoUpdate=registry

# Unhealthy while in maintenance mode (e.g. during upgrades), not just when Apache is down
HealthCmd=curl -fsS http://127.0.0.1/status.php | grep -q '"maintenance":false'
HealthInterval=1m
# First install and major upgrades run before Apache starts
HealthStartPeriod=10m
Network=devops
Volume=nextcloud-data:/var/www/html

# --- Database (existing rootless Postgres, by container name) ---
Environment=POSTGRES_HOST=postgres
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_USER=nextcloud
Secret=nextcloud-db-password,type=env,target=POSTGRES_PASSWORD

# --- Cache + file locking (existing Valkey; speaks the Redis protocol) ---
Environment=REDIS_HOST=valkey
Environment=REDIS_HOST_PORT=6379
# If your Valkey requires auth, add a secret and uncomment:
# Secret=valkey_password,type=env,target=REDIS_HOST_PASSWORD

# --- Reverse proxy / URL handling ---
Environment=NEXTCLOUD_TRUSTED_DOMAINS=cloud.fivelabs.tech nextcloud
Environment=TRUSTED_PROXIES=10.89.1.0/24
Environment=OVERWRITEPROTOCOL=https
Environment=OVERWRITEHOST=cloud.fivelabs.tech
Environment=OVERWRITECLIURL=https://cloud.fivelabs.tech

# --- PHP / uploads ---
Environment=PHP_UPLOAD_LIMIT=10G
Environment=PHP_MEMORY_LIMIT=1G

# --- First-run admin (auto-installs; skip if you prefer the web installer) ---
Environment=NEXTCLOUD_ADMIN_USER=admin
Secret=nextcloud-admin-password,type=env,target=NEXTCLOUD_ADMIN_PASSWORD

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
