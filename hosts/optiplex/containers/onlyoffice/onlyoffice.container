[Unit]
Description=ONLYOFFICE Document Server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=onlyoffice
Image=docker.io/onlyoffice/documentserver:9.4.0
AutoUpdate=registry

# Returns "true" once the document server and its bundled services are up
HealthCmd=curl -fsS http://127.0.0.1/healthcheck | grep -q true
HealthInterval=1m
HealthStartPeriod=3m
Network=devops
Volume=onlyoffice-data:/var/www/onlyoffice/Data
Volume=onlyoffice-log:/var/log/onlyoffice
Volume=onlyoffice-db:/var/lib/postgresql
Environment=JWT_ENABLED=true
Secret=onlyoffice-jwt-secret,type=env,target=JWT_SECRET

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
