[Unit]
Description=OpenBao Secure Secret Storage
# Requires=postgres.service
# After=postgres.service

[Container]
ContainerName=openbao
Image=ghcr.io/openbao/openbao:2
AutoUpdate=registry

# Non-2xx (sealed 503, uninitialized 501, standby 429) fails the check
HealthCmd=wget -qO /dev/null http://127.0.0.1:8200/v1/sys/health
HealthStartPeriod=30s

Network=devops
HostName=openbao
PublishPort=8200:8200

Environment=BAO_DEV_ROOT_TOKEN_ID=foobar

Volume=openbao-config:/openbao/config:z
# Volume=%h/homelab/hosts/optiplex/.certs/optiplex.lan.key:/certs/server.key:z
# Volume=%h/homelab/hosts/optiplex/.certs/optiplex.lan.cert:/certs/server.cert:z

[Service]
Restart=always
TimeoutStartSec=1000

[Install]
WantedBy=default.target
