[Unit]
Description=Postgres database
After=network-online.target

Requires=devops.network
After=devops.network

[Container]
ContainerName=postgres
Image=docker.io/postgres:18-alpine
AutoUpdate=registry

HealthCmd="pg_isready -U postgres"

Network=devops
HostName=postgres
PublishPort=5432:5432

# Only used by initdb when the data volume is empty; change it later with ALTER ROLE
Secret=postgres-superuser-password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-superuser-password

Volume=postgres-data-18:/var/lib/postgresql/18/docker:Z

[Service]
Restart=always
TimeoutStartSec=1000

[Install]
WantedBy=default.target
