[Unit]
Description=qBittorrent Container
After=gluetun.service
Requires=gluetun.service
BindsTo=gluetun.service

[Container]
ContainerName=qbittorrent
Image=docker.io/linuxserver/qbittorrent:latest

HealthCmd=curl http://127.0.0.1:8080

Volume=qbittorrent-config:/config
Volume=/mnt/Archive/Downloads:/downloads:z
Volume=%h/homelab/hosts/optiplex/.certs:/Certs:z,ro

Environment=TZ=America/New_York
# Environment=PUID=0
# Environment=PGID=0
Environment=WEBUI_PORT=8080

# All traffic routes through gluetun's netns
Network=container:gluetun
UserNS=keep-id:uid=1000,gid=1000

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=default.target
