[Unit]
Description=Technitium DNS server
After=network-online.target

[Container]
ContainerName=technitium
Environment=DNS_SERVER_DOMAIN=optiplex.dns
HostName=optiplex.dns
Image=docker.io/technitium/dns-server:15.5.0
Network=host
PublishPort=53:53/udp
PublishPort=53:53/tcp
PublishPort=53443:53443

HealthCmd="dig @127.0.0.1 google.com"

Volume=technitium-data:/etc/dns

[Service]
Restart=always
